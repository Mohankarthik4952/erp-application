generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime    @default(now())
  enquiries    Enquiry[]
  quotations   Quotation[]
}

model Customer {
  id            Int          @id @default(autoincrement())
  companyName   String
  contactPerson String
  mobile        String
  email         String
  city          String
  createdAt     DateTime     @default(now())
  enquiries     Enquiry[]
  quotations    Quotation[]
  orders        SalesOrder[]

  @@index([companyName])
}

model Product {
  id            Int              @id @default(autoincrement())
  productCode   String           @unique
  productName   String
  category      String
  unit          String
  basePrice     Decimal          @db.Decimal(12, 2)
  createdAt     DateTime         @default(now())
  dispatchItems DispatchItem[]
  enquiryItems  EnquiryItem[]
  inventory     Inventory?
  quoteItems    QuotationItem[]
  orderItems    SalesOrderItem[]

  @@index([category])
}

model Inventory {
  id               Int      @id @default(autoincrement())
  productId        Int      @unique
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Enquiry {
  id           Int           @id @default(autoincrement())
  enquiryNo    String        @unique
  customerId   Int
  enquiryDate  DateTime      @default(now())
  requiredDate DateTime
  notes        String?
  status       EnquiryStatus @default(NEW)
  createdById  Int
  createdAt    DateTime      @default(now())
  createdBy    User          @relation(fields: [createdById], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  items        EnquiryItem[]
  quotations   Quotation[]

  @@index([customerId])
  @@index([createdById])
  @@index([status])
}

model EnquiryItem {
  id        Int     @id @default(autoincrement())
  enquiryId Int
  productId Int
  quantity  Int
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([enquiryId, productId])
  @@index([productId])
}

model Quotation {
  id          Int             @id @default(autoincrement())
  quotationNo String          @unique
  enquiryId   Int
  customerId  Int
  createdById Int
  validUntil  DateTime
  status      QuotationStatus @default(DRAFT)
  grandTotal  Decimal         @db.Decimal(14, 2)
  createdAt   DateTime        @default(now())
  createdBy   User            @relation(fields: [createdById], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])
  enquiry     Enquiry         @relation(fields: [enquiryId], references: [id])
  items       QuotationItem[]
  order       SalesOrder?

  @@index([enquiryId])
  @@index([customerId])
  @@index([createdById])
  @@index([status])
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  productId   Int
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  discountPct Decimal   @default(0) @db.Decimal(5, 2)
  gstPct      Decimal   @default(0) @db.Decimal(5, 2)
  lineAmount  Decimal   @db.Decimal(14, 2)
  product     Product   @relation(fields: [productId], references: [id])
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, productId])
  @@index([productId])
}

model SalesOrder {
  id          Int              @id @default(autoincrement())
  orderNo     String           @unique
  quotationId Int              @unique
  customerId  Int
  orderDate   DateTime         @default(now())
  totalAmount Decimal          @db.Decimal(14, 2)
  status      SalesOrderStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  dispatches  Dispatch[]
  customer    Customer         @relation(fields: [customerId], references: [id])
  quotation   Quotation        @relation(fields: [quotationId], references: [id])
  items       SalesOrderItem[]

  @@index([customerId])
  @@index([status])
}

model SalesOrderItem {
  id           Int        @id @default(autoincrement())
  salesOrderId Int
  productId    Int
  quantity     Int
  product      Product    @relation(fields: [productId], references: [id])
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@unique([salesOrderId, productId])
  @@index([productId])
}

model Dispatch {
  id            Int            @id @default(autoincrement())
  dispatchNo    String         @unique
  salesOrderId  Int
  dispatchDate  DateTime       @default(now())
  vehicleNumber String
  driverName    String
  createdAt     DateTime       @default(now())
  salesOrder    SalesOrder     @relation(fields: [salesOrderId], references: [id])
  items         DispatchItem[]

  @@index([salesOrderId])
}

model DispatchItem {
  id         Int      @id @default(autoincrement())
  dispatchId Int
  productId  Int
  quantity   Int
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([productId])
}

enum UserRole {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}
